# Telegram BotFather에서 발급받은 토큰
TELEGRAM_BOT_TOKEN=replace_with_botfather_token

# 허용할 Telegram 숫자 chat ID. 여러 개는 쉼표로 구분합니다.
TELEGRAM_ALLOWED_CHAT_IDS=replace_with_your_chat_id

# KORAIL 계정 정보: Telegram 대화로 입력하지 않고 이 파일에서만 관리합니다.
KORAIL_ID=replace_with_korail_id
KORAIL_PASSWORD=replace_with_korail_password

# Telegram 봇 예약의 카드 자동 결제 설정
# true로 설정하면 예약 성공 직후 아래 카드 정보로 자동 결제를 시도합니다.
# 실제 결제를 원하지 않으면 반드시 false로 설정하세요.
KORAIL_AUTO_PAYMENT_ENABLED=false

# 카드번호: 숫자만 입력하며 12~19자리입니다. 공백이나 하이픈은 사용하지 마세요.
KORAIL_CARD_NUMBER=

# 카드 비밀번호: 카드 비밀번호 앞 2자리만 입력합니다.
KORAIL_CARD_PASSWORD=

# 카드 유효기간: YYMM 형식입니다. 예: 2031년 9월 → 3109
KORAIL_CARD_EXPIRE=

# 개인 카드: 생년월일 앞 6자리(YYMMDD), 법인 카드: 사업자등록번호 앞 6자리
KORAIL_CARD_BIRTHDAY=

# 할부개월: 0은 일시불이며, 할부는 01~24 사이의 숫자를 입력합니다.
KORAIL_CARD_INSTALLMENT=0

# 카드 유형: J=개인 카드, S=법인 카드
KORAIL_CARD_TYPE=J

# 기본 조회 주기와 추가 랜덤 지연(초)
# 아래 예시는 1.1~1.5초 간격입니다.
KORAIL_SEARCH_INTERVAL_SECONDS=1
KORAIL_SEARCH_JITTER_MIN_SECONDS=0.1
KORAIL_SEARCH_JITTER_MAX_SECONDS=0.5

# 예약 작업 최대 실행 시간(분)
KORAIL_MAX_SEARCH_MINUTES=10
