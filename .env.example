# Telegram BotFather에서 발급받은 토큰
TELEGRAM_BOT_TOKEN=replace_with_botfather_token

# 허용할 Telegram 숫자 chat ID. 여러 개는 쉼표로 구분합니다.
TELEGRAM_ALLOWED_CHAT_IDS=replace_with_your_chat_id

# 기본 조회 주기와 추가 랜덤 지연(초)
# 아래 예시는 1.1~1.5초 간격입니다.
KORAIL_SEARCH_INTERVAL_SECONDS=1
KORAIL_SEARCH_JITTER_MIN_SECONDS=0.1
KORAIL_SEARCH_JITTER_MAX_SECONDS=0.5

# 예약 작업 최대 실행 시간(분)
KORAIL_MAX_SEARCH_MINUTES=10
